/* ---------- Theme tokens (bugblazer.dev style) ---------- */
:root {
  --bg: #f4efe4;
  --grid: rgba(17, 17, 17, 0.05);
  --surface: #fffdf7;
  --text: #111111;
  --muted: #55504a;
  --border: #111111;
  --shadow: #111111;
  --accent: #ff6a00;
  --nav-bg: rgba(244, 239, 228, 0.97);
  --sans: var(--font-sans), system-ui, sans-serif;
  --mono: var(--font-mono), ui-monospace, monospace;
}

[data-theme="dark"] {
  --bg: #15130f;
  --grid: rgba(244, 239, 228, 0.04);
  --surface: #1f1c17;
  --text: #f4efe4;
  --muted: #b5ada0;
  --border: #f4efe4;
  --shadow: #3a352d;
  --nav-bg: rgba(21, 19, 15, 0.97);
}

/* ---------- Base ---------- */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: var(--sans);
  color: var(--text);
  background-color: var(--bg);
  background-image:
    linear-gradient(var(--grid) 1px, transparent 1px),
    linear-gradient(90deg, var(--grid) 1px, transparent 1px);
  background-size: 28px 28px;
  line-height: 1.6;
}

a {
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

h1,
h2,
h3 {
  margin: 0 0 12px;
  line-height: 1.15;
}

p {
  margin: 0 0 12px;
}

.container {
  width: min(1120px, 92%);
  margin: 0 auto;
}

.muted {
  color: var(--muted);
}

.mono {
  font-family: var(--mono);
}

.center {
  text-align: center;
  margin-top: 40px;
}

/* ---------- Navbar ---------- */
.navbar {
  position: sticky;
  top: 0;
  z-index: 50;
  background: var(--nav-bg);
  border-bottom: 2px solid var(--border);
  backdrop-filter: blur(6px);
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: 72px;
}

.brand {
  font-weight: 800;
  font-size: 20px;
  text-decoration: none;
  white-space: nowrap;
}

.nav-links {
  display: flex;
  gap: 6px;
}

.nav-link {
  padding: 8px 14px;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
}

.nav-link:hover {
  background: var(--accent);
  color: #111111;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.icon-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  border: 2px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-weight: 600;
  cursor: pointer;
  box-shadow: 3px 3px 0 var(--shadow);
}

.menu-btn {
  display: none;
}

/* ---------- Buttons & chips ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 20px;
  border: 2px solid var(--border);
  border-radius: 10px;
  background: var(--surface);
  color: var(--text);
  font: inherit;
  font-weight: 700;
  text-decoration: none;
  cursor: pointer;
  box-shadow: 4px 4px 0 var(--shadow);
  transition: transform 0.1s, box-shadow 0.1s;
}

.btn:hover {
  transform: translate(-2px, -2px);
  box-shadow: 6px 6px 0 var(--shadow);
}

.btn-primary {
  background: var(--accent);
  color: #111111;
}

.btn-small {
  padding: 8px 14px;
  font-size: 14px;
  box-shadow: 3px 3px 0 var(--shadow);
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 28px;
}

.link-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--accent);
  font-weight: 700;
  text-decoration: none;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border: 2px solid var(--border);
  border-radius: 8px;
  background: var(--surface);
  font-family: var(--mono);
  font-size: 14px;
}

/* ---------- Sections ---------- */
.section {
  padding: 80px 0;
  border-top: 2px solid var(--border);
}

.section-title {
  font-size: clamp(34px, 5vw, 48px);
  font-weight: 800;
  letter-spacing: -0.02em;
}

.section-sub {
  color: var(--muted);
  font-size: 18px;
  margin-bottom: 40px;
}

.card {
  background: var(--surface);
  border: 2px solid var(--border);
  border-radius: 14px;
  box-shadow: 6px 6px 0 var(--shadow);
}

/* ---------- Hero ---------- */
.hero {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 56px;
  align-items: center;
  padding: 72px 0 64px;
}

.hero-title {
  display: flex;
  flex-direction: column;
  gap: 0.12em;
  margin: 0 0 16px 0;
  line-height: 1.15;
}

.hero-name {
  font-size: clamp(36px, 5.5vw, 58px);
  font-weight: 800;
  letter-spacing: -0.03em;
  white-space: nowrap;
  /* এক লাইনে থাকবে */
  display: block;
}

.hero-tagline {
  font-size: clamp(22px, 3.8vw, 36px);
  /* নামের চেয়ে ছোট */
  font-weight: 650;
  /* semi-bold */
  letter-spacing: -0.02em;
  display: block;
  line-height: 1.2;
}

.hero-intro {
  font-size: 18px;
  color: var(--muted);
  max-width: 520px;
}

/* Photo frame - soft shadow + better image position */
.photo-frame {
  border: 2px solid var(--border);
  border-radius: 14px;
  background: var(--surface);
  /* কালো hard shadow এর বদলে soft + slightly muted shadow */
  box-shadow: 8px 8px 0 rgba(17, 17, 17, 0.18);
  padding: 8px;
  overflow: hidden;
}

.photo-frame img,
.hero-photo {
  width: 100%;
  aspect-ratio: 4 / 5;
  /* একটু লম্বা করে মাথা ভালো দেখাবে */
  object-fit: cover;
  object-position: center 12%;
  /* মাথা পুরো দেখানোর জন্য উপরে ফোকাস */
  border-radius: 8px;
  display: block;
}

/* ---------- Work cards ---------- */
.work-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 32px;
}

.project-card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.card-main {
  display: block;
  flex: 1;
  text-decoration: none;
}

.card-img {
  aspect-ratio: 16 / 10;
  background: linear-gradient(135deg, #ff6a00, #2a2622);
  border-bottom: 2px solid var(--border);
  overflow: hidden;
}

.card-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-body {
  padding: 20px;
}

.card-body h3 {
  font-size: 22px;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 14px 20px;
  border-top: 2px solid var(--border);
}

/* ---------- Skills ---------- */
.skills-card {
  padding: 8px 28px;
}

.skill-row {
  display: grid;
  grid-template-columns: 200px 1fr;
  gap: 16px;
  padding: 22px 0;
  border-bottom: 1px dashed var(--muted);
}

.skill-row:last-child {
  border-bottom: none;
}

.skill-label {
  font-size: 18px;
  margin: 0;
}

.chip svg {
  font-size: 18px;
}

/* ---------- About ---------- */
.about-text {
  max-width: 820px;
}

.about-text h3 {
  font-size: 22px;
  margin-top: 24px;
}

.about-text p {
  font-size: 17px;
  color: var(--muted);
}

/* ---------- Resume & contact ---------- */
.contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
  margin-bottom: 32px;
}

.contact-item {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 22px;
  text-decoration: none;
}

.contact-item svg {
  font-size: 26px;
}

.contact-item span {
  color: var(--muted);
  font-size: 14px;
  word-break: break-all;
}

.social-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.icon-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  border: 2px solid var(--border);
  border-radius: 12px;
  background: var(--surface);
  color: var(--text);
  font-size: 22px;
  box-shadow: 3px 3px 0 var(--shadow);
}

.footer {
  border-top: 2px solid var(--border);
  padding: 24px 0;
  margin-top: 40px;
  text-align: center;
  color: var(--muted);
  font-size: 14px;
}

/* ---------- Project details page ---------- */
.details-page {
  padding: 48px 0 80px;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  text-decoration: none;
  margin-bottom: 24px;
}

.details-img {
  width: 100%;
  max-height: 420px;
  object-fit: cover;
  border: 2px solid var(--border);
  border-radius: 14px;
  box-shadow: 6px 6px 0 var(--shadow);
  margin: 24px 0 8px;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  margin-top: 24px;
}

.stat {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 180px;
  padding: 16px 22px;
}

.stat-num {
  font-size: 32px;
  font-weight: 800;
  color: var(--accent);
}

.details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28px;
  margin-top: 32px;
}

.panel {
  padding: 24px;
}

.panel h2 {
  font-size: 22px;
}

.feature-list {
  margin: 0;
  padding-left: 18px;
}

.feature-list li {
  margin-bottom: 10px;
}

/* ---------- Responsive ---------- */
@media (max-width: 860px) {
  .hero {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .hero-name {
    white-space: normal;
    /* মোবাইলে ভাঙতে দিন */
  }

  .details-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 800px) {
  .menu-btn {
    display: inline-flex;
  }

  .nav-links {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    gap: 4px;
    padding: 12px 4%;
    background: var(--nav-bg);
    border-bottom: 2px solid var(--border);
  }

  .nav-links.open {
    display: flex;
  }
}

@media (max-width: 640px) {
  .skill-row {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .btn-label {
    display: none;
  }
}
</file>

